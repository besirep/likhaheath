# LikhaHealth — Client Environment Variables
#
# Copy this file to `.env.local` and fill in your values.
# .env.local is gitignored and will NOT be committed to the repo.
#
# ─── LAN Deployment ────────────────────────────────────────────────────────────
# Point this to the server PC's LAN IP and port.
# Example: the server PC's IP is 192.168.1.10
VITE_API_BASE_URL=http://192.168.1.10:5000/api
